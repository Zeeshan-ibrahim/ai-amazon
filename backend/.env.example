PORT=4000

# Postgres connection. Local: createdb quick_on_amazon
# Supabase on Vercel: the Transaction pooler string (port 6543).
# Supabase for migrations from your machine: the Session pooler string (port 5432).
DATABASE_URL=postgres://localhost:5432/quick_on_amazon

# Signs session cookies. Use a long random value: openssl rand -hex 32
JWT_SECRET=change-me

# Receipt screenshots. With SUPABASE_URL set they go to that project's private
# Storage bucket (required on Vercel); otherwise to UPLOAD_DIR/receipts on disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=receipts
UPLOAD_DIR=./uploads

# Frontend origin(s) allowed to send the session cookie, comma-separated.
CLIENT_ORIGIN=http://localhost:3000
